# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
.venv*/
venv/
ENV/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Models (large binary files - download separately)
models/
!models/.gitkeep
kokoro-v0_19.onnx
voices.bin

# Data (runtime generated)
data/
!data/.gitkeep

# Briefing engine: the unread-mail cache, the derived known-correspondent set (it lives inside the
# cache), your --mark rules, and your personal overrides (VIPs, allowlisted senders). Personal
# data: never commit. (data/ above already covers the first three; these are explicit on purpose.)
data/briefing.db
data/briefing.db-*
data/briefing_rules.json
config/briefing.local.yaml

# Logs
logs/
!logs/.gitkeep
*.log
*.log.*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Secrets and configs with sensitive data
*.pem
*.key
secrets.yaml
.env.local

# Environment files — every variant, at any depth (a committed template is the exception)
.env
.env.*
!.env.example
!.env.template

# Claude Code per-machine settings: these accumulate pasted commands, which can
# embed API keys. Ignore them in THIS repo, not only in a global gitignore.
.claude/settings.local.json
.claude/*.local.*

# Jupyter
.ipynb_checkpoints/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Additional Python tooling caches
.ruff_cache/
.hypothesis/
.cache/

# Local Python version managers
.python-version

# Voice input (PV3) — user-generated / heavy artifacts
voice/.venv/
voice/training_data/
voice/models/*.onnx
voice/models/*.bin
